# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Emulator (for local development)
# Set to "true" to use local Firebase Emulator instead of production
# This is automatically set by npm scripts (dev:local / dev:prod)
# VITE_USE_EMULATOR=true

# Replicate API (for AI Stem Extractor)
# Get your API token from https://replicate.com/account/api-tokens
# WARNING: This token will be exposed in the browser bundle - only for local development/testing
VITE_REPLICATE_API_TOKEN=

# ─── Firebase Cloud Functions ──────────────────────────────────────────────────
# Set ALL of these via Firebase Secret Manager before deploying:
#   firebase functions:secrets:set POLAR_WEBHOOK_SECRET
#   firebase functions:secrets:set POLAR_ACCESS_TOKEN
#   firebase functions:secrets:set POLAR_PRODUCT_ID_3
#   firebase functions:secrets:set POLAR_PRODUCT_ID_5
#   firebase functions:secrets:set POLAR_PRODUCT_ID_10
#
# POLAR_WEBHOOK_SECRET : From Polar Dashboard → Settings → Webhooks → your endpoint secret
# POLAR_ACCESS_TOKEN   : From Polar Dashboard → Settings → Developers → Access Tokens (read + write checkouts scope)
# POLAR_PRODUCT_ID_*   : From Polar Dashboard → Products → copy the product UUID (not the checkout link ID)
POLAR_WEBHOOK_SECRET=
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID_3=
POLAR_PRODUCT_ID_5=
POLAR_PRODUCT_ID_10=
