{
  "name": "rtttl-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:local": "VITE_USE_EMULATOR=true vite --host 0.0.0.0",
    "dev:prod": "VITE_USE_EMULATOR=false vite --host 0.0.0.0",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "sitemap:check": "npm run sitemap && tsx scripts/check-sitemap.ts",
    "build": "npm run sitemap && tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"firebase/functions/src/**/*.ts\"",
    "preview": "vite preview",
    "test": "vitest run",
    "generate-picaxe": "tsx scripts/generate-picaxe.ts",
    "generate-logos": "tsx scripts/generate-logos.ts",
    "generate-placeholder": "tsx scripts/generate-placeholder.ts",
    "prepare": "husky",
    "firebase:emulator": "npx firebase --config firebase/firebase.json --project rtttl-hub emulators:start",
    "firebase:deploy": "npx firebase --config firebase/firebase.json --project rtttl-hub deploy",
    "firebase:deploy:rules": "npx firebase --config firebase/firebase.json --project rtttl-hub deploy --only firestore:rules",
    "firebase:deploy:functions": "npx firebase --config firebase/firebase.json --project rtttl-hub deploy --only functions",
    "firebase:login": "npx firebase login"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "src/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "src/**/*.css": [
      "prettier --write"
    ]
  },
  "license": "AGPL-3.0",
  "homepage": "https://rtttl-hub.io",
  "dependencies": {
    "-": "^0.0.1",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.10",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-virtual": "^3.14.10",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.8",
    "react-avatar-editor": "^15.1.0",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.11",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sharp": "^0.32.0",
    "@vitejs/plugin-react": "^6.1.0",
    "adm-zip": "^0.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
